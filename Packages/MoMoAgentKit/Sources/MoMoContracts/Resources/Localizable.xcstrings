    "手机与手表分别跟随各自的系统语言设置，录音识别语言单独设置。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The phone and watch each use their device's language settings. Set the recording language separately."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとApple Watchは、それぞれの端末の言語設定に従います。録音の認識言語は個別に設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone과 Apple Watch는 각 기기의 언어 설정을 따릅니다. 녹음 인식 언어는 별도로 설정합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机与手表分别跟随各自的系统语言设置，录音识别语言单独设置。"
          }
        }
      }
    },
    "手机同步的录音稿会按日期出现在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcripts synced from your iPhone will appear here by date."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机同步的录音稿会按日期出现在这里。"
          }
        }
      }
    },
    "手机回执与录音片段不匹配，原音已保留。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mobile phone receipt does not match the recording clip, and the original audio has been retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "携帯電話の受信音は録音クリップと一致せず、元のサウンドが保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 영수증이 녹음 클립과 일치하지 않아 원본 사운드가 유지되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机回执与录音片段不匹配，原音已保留。"
          }
        }
      }
    },
    "手机处理状态尚未同步": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
