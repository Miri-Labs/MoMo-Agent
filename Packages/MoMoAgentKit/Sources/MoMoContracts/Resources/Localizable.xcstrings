    "手表的对账请求属于旧资料库，将发送当前资料库身份。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The reconciliation request for the watch belongs to the old repository and will send the current repository identity."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "監視の調整リクエストは古いリポジトリに属しており、現在のリポジトリ ID を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
