    "请填写 API Key。聊天订阅不等于 API 凭证。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please fill in the API Key. Chat subscriptions are not equivalent to API credentials."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API キーを入力してください。チャット サブスクリプションは API 認証情報と同等ではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key를 입력해주세요. 채팅 구독은 API 자격 증명과 동일하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
