    "%@ 个来源暂时无法读取，稍后重试；其他资料继续整理。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sources cannot be read temporarily. Please try again later; other data will continue to be sorted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ソースを一時的に読み取れません。後でもう一度試してください。他のデータは引き続き並べ替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 소스를 일시적으로 읽을 수 없습니다. 나중에 다시 시도해 주세요. 다른 데이터는 계속해서 정렬됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个来源暂时无法读取，稍后重试；其他资料继续整理。"
