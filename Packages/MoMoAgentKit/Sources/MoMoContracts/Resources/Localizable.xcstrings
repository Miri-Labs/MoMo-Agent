            "state": "translated",
            "value": "The main text supports Markdown, and you can freely write paragraphs, titles and lists."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本文はMarkdownに対応しており、段落やタイトル、リストなどを自由に記述できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
