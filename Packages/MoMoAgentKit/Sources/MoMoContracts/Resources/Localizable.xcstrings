        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 카탈로그 요청이 승인되지 않았습니다. 모델 ID를 수동으로 입력한 후 디렉토리 권한을 확인하거나 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型目录请求未获授权。可以检查目录权限，或手动填写模型 ID 后验证。"
