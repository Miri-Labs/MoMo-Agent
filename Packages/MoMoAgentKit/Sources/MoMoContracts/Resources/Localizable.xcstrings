          }
        }
      }
    },
    "旧版授权可能仍关联旧签名。在系统设置中移除旧条目，重新添加当前 App，再重新打开 App。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An older permission may still reference a previous signature. Remove the old entry in System Settings, add the current app, then reopen it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の許可が古い署名に紐づいている可能性があります。システム設定で古い項目を削除し、現在の App を追加してから、App を開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 권한이 오래된 서명에 연결되어 있을 수 있습니다. 시스템 설정에서 기존 항목을 제거하고 현재 앱을 다시 추가한 다음 앱을 다시 여세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版授权可能仍关联旧签名。在系统设置中移除旧条目，重新添加当前 App，再重新打开 App。"
          }
        }
      }
    },
