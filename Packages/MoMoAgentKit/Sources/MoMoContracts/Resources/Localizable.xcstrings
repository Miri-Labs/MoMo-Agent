    "健康数据在锁屏时无法读取，请解锁 iPhone 后重试。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data cannot be read when the screen is locked. Please unlock your iPhone and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面がロックされている場合、健康データを読み取ることができません。 iPhone のロックを解除して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면이 잠겨 있으면 건강 데이터를 읽을 수 없습니다. iPhone의 잠금을 해제하고 다시 시도해 주세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康数据在锁屏时无法读取，请解锁 iPhone 后重试。"
          }
        }
      }
    },
