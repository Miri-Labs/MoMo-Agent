        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태그가 예약되어 있습니다. 여기의 원본 오디오는 동기화되지 않았거나 더 이상 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
