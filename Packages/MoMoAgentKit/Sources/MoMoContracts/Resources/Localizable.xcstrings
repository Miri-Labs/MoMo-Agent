      }
    },
    "先连接服务并读取模型，再验证所选模型。\n模型验证可能产生少量 API 费用。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the service and read the model before validating the selected model. \n model validation may incur a small API fee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデルを検証する前に、サービスに接続してモデルを読み取ります。 \n モデルの検証には少額の API 料金が発生する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델을 검증하기 전에 서비스에 연결하고 모델을 읽으십시오. \n 모델 검증에는 소액의 API 수수료가 발생할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先连接服务并读取模型，再验证所选模型。\n模型验证可能产生少量 API 费用。"
          }
        }
      }
    },
