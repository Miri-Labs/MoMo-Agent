          "stringUnit": {
            "state": "translated",
            "value": "音声検出のしきい値は 0.05 ～ 0.95 の範囲にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 감지 임계값은 0.05에서 0.95 사이여야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音检测阈值须在 0.05 至 0.95 之间。"
          }
        }
      }
    },
