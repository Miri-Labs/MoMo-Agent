    "部分内容未能完成转写，已收到的音频会保留。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some content could not be transcribed, and the received audio will be retained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のコンテンツは文字起こしできませんでした。受信した音声は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 콘텐츠를 복사할 수 없으며 수신된 오디오가 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分内容未能完成转写，已收到的音频会保留。"
          }
        }
      }
    },
    "部分原音不可用，可用的录音已继续处理": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the original audio is not available, and the available recordings have been processed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のサウンドの一部が利用できず、利用可能な録音は処理されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원음의 일부가 나오지 않고, 사용 가능한 녹음이 처리되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分原音不可用，可用的录音已继续处理"
          }
        }
      }
    },
    "部分原音尚不可用或已清理，播放器中的断点不可定位，文字仍可阅读。": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of the original audios are not yet available or have been cleaned, the breakpoints in the player cannot be located, and the text can still be read."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルのサウンドの一部はまだ利用できないか、クリーンアップされていますが、プレーヤーのブレークポイントは見つかりませんが、テキストはまだ読み取ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원래 사운드 중 일부는 아직 사용할 수 없거나 정리되었으며 플레이어의 중단점을 찾을 수 없으며 텍스트를 계속 읽을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分原音尚不可用或已清理，播放器中的断点不可定位，文字仍可阅读。"
          }
        }
      }
    },
    "部分原音已按保留设置清理": {
      "extractionState": "manual",
      "generatesSymbol": false,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the original audio has been cleaned according to the retention settings"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "原音の一部が保持設定に従ってクリーン化されました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보존 설정에 따라 원음 일부가 정리되었습니다."
          }
        },
