<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>$(MOMO_APP_DISPLAY_NAME)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>ja</string>
		<string>ko</string>
	</array>
	<key>CFBundleName</key>
	<string>$(MOMO_APP_DISPLAY_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(MOMO_WATCH_WIDGET_KIND)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(MOMO_WATCH_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>MoMoWatchAppGroup</key>
	<string>$(MOMO_WATCH_APP_GROUP)</string>
	<key>MoMoWatchURLScheme</key>
	<string>$(MOMO_WATCH_URL_SCHEME)</string>
	<key>MoMoWatchWidgetKind</key>
	<string>$(MOMO_WATCH_WIDGET_KIND)</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSHealthShareUsageDescription</key>
	<string>在手表连续录音期间同步读取实时心率，用于维持录音连续性并帮助 MoMo 理解你的状态。</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>在手表连续录音期间维护系统健康会话以防止通话等中断导致录音停止，结束时自动丢弃，不会写入你的体能训练记录。</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>允许通过局域网校验通道直接与配对的 iPhone 高速同步录音。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>在你开始录音后采集声音，经由配对的 iPhone 同步至 Mac 完成转录。</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>WKApplication</key>
	<true/>
	<key>WKBackgroundModes</key>
	<array>
		<string>workout-processing</string>
	</array>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>$(MOMO_PHONE_BUNDLE_ID)</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
</dict>
</plist>
