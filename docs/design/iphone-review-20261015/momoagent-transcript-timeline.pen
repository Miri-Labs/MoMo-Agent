          "x": 24,
          "y": 984,
          "name": "导航契约",
          "content": "左「聊天」右「转录」，各自保留导航状态。侧栏管理聊天，不再放转录。\n从转录发起讨论时切到聊天并携带引用，转录详情保留。首次体验完成后才出现底栏。\n底栏采用原生 TabView 与系统 Liquid Glass；本板截图记录默认字号。",
          "fill": "#252525",
          "fontFamily": "Noto Sans SC",
          "fontSize": 16,
          "fontWeight": "normal",
          "lineHeight": 1.5,
          "width": 1260,
          "textGrowth": "fixed-width"
        }
